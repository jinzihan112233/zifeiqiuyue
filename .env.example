DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@127.0.0.1:55432/zifeiqiuyue_dev
DATABASE_TEST_URL=postgresql://APP_USER:APP_PASSWORD@127.0.0.1:55432/zifeiqiuyue_test
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET
APP_ORIGIN=http://127.0.0.1:3000
MEDIA_ROOT=storage/media
